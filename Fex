TARGET = fex

build: test
    go build -o $TARGET ./...
end

test: vet
    go test -race -count=1 -cover ./...
    go test -run=FuzzParseData -fuzz=FuzzParseData -fuzztime=3s ./src
end

testv:
    go test -v -race -count=1 -cover ./...
    go vet ./...
    go test -v -run=FuzzParseData -fuzz=FuzzParseData -fuzztime=3s ./src
end

vet:
    go vet ./...
end
